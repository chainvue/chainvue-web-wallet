# Store packaging output. Rebuild with `npm run package`.
dist/

# Build output. Reproduce with `npm run build:wasm`.
#
# `wasm/Cargo.lock` is deliberately NOT here. The SDK is pinned by revision, but
# a revision pins only that crate — every transitive dependency underneath it,
# including the crypto, resolves fresh at build time without a lockfile. Two
# builds of the same commit could then produce different wasm, which makes a
# release impossible to verify and contradicts the claim this comment used to
# make. Committing it is what makes "the bytes are determined by the lockfile
# and the pin" true.
src/vendor/
wasm/target/
