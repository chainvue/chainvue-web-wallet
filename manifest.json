{
  "manifest_version": 3,
  "name": "Verus Launchpad Wallet",
  "version": "0.1.0",
  "description": "Non-custodial Verus wallet. Keys stay in the browser; every transaction is shown decoded before it is signed.",
  "minimum_chrome_version": "116",

  "permissions": ["storage"],

  "host_permissions": [
    "https://api.verustest.net/*",
    "https://api.verus.services/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/inpage.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Verus Launchpad Wallet"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
